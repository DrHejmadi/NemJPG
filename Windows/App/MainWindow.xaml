<Window x:Class="NemJPG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NemJPG"
        Width="520" Height="460"
        MinWidth="420" MinHeight="360"
        ResizeMode="CanResize"
        Background="#0F0F17"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ResultItem" TargetType="Border">
            <Setter Property="Background" Value="#1A1A28"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#5E5CE6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7B79F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4A48C8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="NemJPG" FontSize="26" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Konverter billeder til JPG · Bedste kvalitet · Samme mappe"
                       FontSize="12" Foreground="#666" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Drop zone -->
        <Border Grid.Row="1"
                x:Name="DropZone"
                Background="#16161F"
                BorderBrush="#2A2A42"
                BorderThickness="2"
                CornerRadius="10"
                AllowDrop="True"
                Drop="OnDrop"
                DragOver="OnDragOver"
                DragLeave="OnDragLeave">

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🖼" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Træk billeder eller mapper hertil"
                           FontSize="16" FontWeight="Medium" Foreground="#CCC"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="PNG · BMP · GIF · TIFF · WebP · HEIC · RAW og mere"
                           FontSize="11" Foreground="#555"
                           HorizontalAlignment="Center" Margin="0,6,0,18"/>
                <Button Content="Vælg filer…" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center" Click="OnSelectFiles"/>
            </StackPanel>

            <!-- Results -->
            <Grid x:Name="ResultsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="12,12,12,4">
                    <ItemsControl x:Name="ResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ResultItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Icon}"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                                   Text="{Binding FileName}"
                                                   Foreground="{Binding Color}"
                                                   FontSize="13" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Margin="8,0,0,0"
                                                   Text="{Binding Summary}"
                                                   Foreground="#555"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="1" Background="#1A1A28" CornerRadius="0,0,8,8" Padding="12,8">
                    <Grid>
                        <TextBlock x:Name="StatusText" Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                        <Button Content="Konverter mere" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right" Padding="14,6"
                                Click="OnConvertMore"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Footer hint -->
        <TextBlock Grid.Row="2" Margin="0,10,0,0"
                   Foreground="#444" FontSize="11" HorizontalAlignment="Center"
                   Text="Højreklik på en billedfil i Stifinder for at bruge NemJPG direkte"/>
    </Grid>
</Window>
