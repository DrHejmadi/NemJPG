<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NemJPG</AssemblyName>
    <RootNamespace>NemJPG</RootNamespace>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Product>NemJPG</Product>
    <Company>Michael Skov Hejmadi</Company>
    <Copyright>Copyright © 2026 Michael Skov Hejmadi</Copyright>
    <Description>Konverter billeder til JPG i bedste kvalitet</Description>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
