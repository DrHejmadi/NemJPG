<?xml version="1.0" encoding="utf-8"?>
<!--
  VIGTIG: Erstat Publisher-feltet nedenfor med din Publisher-identitet fra Microsoft Partner Center.
  Find den under: Partner Center → Kontoindstillinger → Organisationsprofil → Publisher-id
  Eksempel: CN=12345678-ABCD-1234-ABCD-1234567890AB
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="rescap uap3 desktop">

  <Identity
    Name="MichaelSkovHejmadi.NemJPG"
    Publisher="CN=PUBLISHER-IDENTITY-FROM-PARTNER-CENTER"
    Version="2.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>NemJPG</DisplayName>
    <PublisherDisplayName>Michael Skov Hejmadi</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Konverter billeder til JPG i bedste kvalitet. Højereklik på en billedfil i Stifinder og vælg NemJPG.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="da-DK" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="NemJPG" Executable="NemJPG.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="NemJPG"
        Description="Konverter billeder til JPG i bedste kvalitet"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          ShortName="NemJPG"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0F0F17" />
      </uap:VisualElements>

      <Extensions>
        <!--
          Tilføjer "NemJPG → Konverter til JPG" i højrekliks-menuen for alle billedformater.
          Windows 11 viser disse direkte i kontekstmenuen (ikke under "Vis flere indstillinger").
        -->
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="nemjpg-png">
            <uap3:SupportedFileTypes>
              <uap3:FileType>.png</uap3:FileType>
            </uap3:SupportedFileTypes>
            <uap3:Verbs>
              <uap3:Verb Id="ConvertToJpg" Parameters="-convert &quot;%1&quot;">Konverter til JPG</uap3:Verb>
            </uap3:Verbs>
          </uap3:FileTypeAssociation>
        </uap3:Extension>

        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="nemjpg-bmp">
            <uap3:SupportedFileTypes>
              <uap3:FileType>.bmp</uap3:FileType>
            </uap3:SupportedFileTypes>
            <uap3:Verbs>
              <uap3:Verb Id="ConvertToJpg" Parameters="-convert &quot;%1&quot;">Konverter til JPG</uap3:Verb>
            </uap3:Verbs>
          </uap3:FileTypeAssociation>
        </uap3:Extension>

        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="nemjpg-gif">
            <uap3:SupportedFileTypes>
              <uap3:FileType>.gif</uap3:FileType>
            </uap3:SupportedFileTypes>
            <uap3:Verbs>
              <uap3:Verb Id="ConvertToJpg" Parameters="-convert &quot;%1&quot;">Konverter til JPG</uap3:Verb>
            </uap3:Verbs>
          </uap3:FileTypeAssociation>
        </uap3:Extension>

        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="nemjpg-tiff">
            <uap3:SupportedFileTypes>
              <uap3:FileType>.tiff</uap3:FileType>
              <uap3:FileType>.tif</uap3:FileType>
            </uap3:SupportedFileTypes>
            <uap3:Verbs>
              <uap3:Verb Id="ConvertToJpg" Parameters="-convert &quot;%1&quot;">Konverter til JPG</uap3:Verb>
            </uap3:Verbs>
          </uap3:FileTypeAssociation>
        </uap3:Extension>

        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="nemjpg-webp">
            <uap3:SupportedFileTypes>
              <uap3:FileType>.webp</uap3:FileType>
            </uap3:SupportedFileTypes>
            <uap3:Verbs>
              <uap3:Verb Id="ConvertToJpg" Parameters="-convert &quot;%1&quot;">Konverter til JPG</uap3:Verb>
            </uap3:Verbs>
          </uap3:FileTypeAssociation>
        </uap3:Extension>

        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="nemjpg-heic">
            <uap3:SupportedFileTypes>
              <uap3:FileType>.heic</uap3:FileType>
              <uap3:FileType>.heif</uap3:FileType>
            </uap3:SupportedFileTypes>
            <uap3:Verbs>
              <uap3:Verb Id="ConvertToJpg" Parameters="-convert &quot;%1&quot;">Konverter til JPG</uap3:Verb>
            </uap3:Verbs>
          </uap3:FileTypeAssociation>
        </uap3:Extension>

        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="nemjpg-raw">
            <uap3:SupportedFileTypes>
              <uap3:FileType>.dng</uap3:FileType>
              <uap3:FileType>.cr2</uap3:FileType>
              <uap3:FileType>.nef</uap3:FileType>
              <uap3:FileType>.arw</uap3:FileType>
              <uap3:FileType>.orf</uap3:FileType>
              <uap3:FileType>.rw2</uap3:FileType>
            </uap3:SupportedFileTypes>
            <uap3:Verbs>
              <uap3:Verb Id="ConvertToJpg" Parameters="-convert &quot;%1&quot;">Konverter til JPG</uap3:Verb>
            </uap3:Verbs>
          </uap3:FileTypeAssociation>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <uap:Capability Name="picturesLibrary" />
  </Capabilities>

</Package>
